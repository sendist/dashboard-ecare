generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
}

model RawOmnix {
  ticketId                     String    @id @map("ticket_id")
  remark                       String?   @map("remark")
  subject                      String?   @map("subject")
  priorityId                   String?   @map("priority_id")
  priorityName                 String?   @map("priority_name")
  ticketStatusId               String?   @map("ticket_status_id")
  ticketStatusName             String?   @map("ticket_status_name")
  unitId                       String?   @map("unit_id")
  unitName                     String?   @map("unit_name")
  informantId                  String?   @map("informant_id")
  informantHp                  String?   @map("informant_hp")
  informantEmail               String?   @map("informant_email")
  customerId                   String?   @map("customer_id")
  customerHp                   String?   @map("customer_hp")
  customerEmail                String?   @map("customer_email")
  dateOriginInteraction        DateTime? @map("date_origin_interaction") @db.Timestamptz(6)
  dateStartInteraction         DateTime? @map("date_start_interaction") @db.Timestamptz(6)
  dateOpen                     DateTime? @map("date_open") @db.Timestamptz(6)
  dateClose                    DateTime? @map("date_close") @db.Timestamptz(6)
  dateLastUpdate               DateTime? @map("date_last_update") @db.Timestamptz(6)
  isEscalated                  String?   @map("is_escalated")
  createdById                  String?   @map("created_by_id")
  createdByName                String?   @map("created_by_name")
  updatedById                  String?   @map("updated_by_id")
  updatedByName                String?   @map("updated_by_name")
  channelId                    String?   @map("channel_id")
  sessionId                    String?   @map("session_id")
  categoryId                   String?   @map("category_id")
  categoryName                 String?   @map("category_name")
  dateCreatedAt                DateTime? @map("date_created_at") @db.Timestamptz(6)
  sla                          String?   @map("sla")
  channelName                  String?   @map("channel_name")
  mainCategory                 String?   @map("mainCategory")
  category                     String?   @map("category")
  subCategory                  String?   @map("subCategory")
  detailSubCategory            String?   @map("detailSubCategory")
  detailSubCategory2           String?   @map("detailSubCategory2")
  datePickupInteraction        DateTime? @map("date_pickup_interaction") @db.Timestamptz(6)
  dateEndInteraction           DateTime? @map("date_end_interaction") @db.Timestamptz(6)
  dateFirstPickupInteraction   DateTime? @map("date_first_pickup_interaction") @db.Timestamptz(6)
  dateFirstResponseInteraction DateTime? @map("date_first_response_interaction") @db.Timestamptz(6)
  account                      String?   @map("account")
  accountName                  String?   @map("account_name")
  informantMemberId            String?   @map("informant_member_id")
  customerMemberId             String?   @map("customer_member_id")
  sentimentIncoming            String?   @map("sentiment_incoming")
  sentimentOutgoing            String?   @map("sentiment_outgoing")
  sentimentAll                 String?   @map("sentiment_all")
  feedback                     String?   @map("feedback")
  sentimentService             String?   @map("sentiment_service")
  parentId                     String?   @map("parent_id")
  countMerged                  String?   @map("count_merged")
  sourceId                     String?   @map("source_id")
  sourceName                   String?   @map("source_name")
  contact                      String?   @map("contact")
  interactionAdditionalInfo    String?   @map("interaction_additional_info")
  informantName                String?   @map("informant_name")
  customerName                 String?   @map("customer_name")
  surveyName                   String?   @map("survey_name")
  surveyId                     String?   @map("survey_id")
  respondentId                 String?   @map("respondent_id")
  ticketIdOld                  String?   @map("ticket_id_old")
  waitingTime                  String?   @map("waitingTime")
  serviceTime                  String?   @map("serviceTime")
  responseTime                 String?   @map("responseTime")
  handlingTime                 String?   @map("handlingTime")
  duration                     String?   @map("duration")
  acw                          String?   @map("acw")
  ticketEdukasiNps             String?   @map("ticket_Edukasi_NPS")
  ticketEscalatedTicket        String?   @map("ticket_Escalated_Ticket")
  customerTwitterId            String?   @map("customer_twitter_id")
  customerPhone                String?   @map("customer_phone")
  slaSecond                    String?   @map("sla_second")
  ticketIdMasking              String?   @map("ticketId_masking")
  dateInProgress               DateTime? @map("date_in_progress") @db.Timestamptz(6)
  datePending                  DateTime? @map("date_pending") @db.Timestamptz(6)
  dateCompleted                DateTime? @map("date_completed") @db.Timestamptz(6)
  dateReopen                   DateTime? @map("date_reopen") @db.Timestamptz(6)
  dateResolved                 DateTime? @map("date_resolved") @db.Timestamptz(6)
  dateClosed                   DateTime? @map("date_closed") @db.Timestamptz(6)
  customerInstagramId          String?   @map("customer_instagram_id")
  customerLivechatId           String?   @map("customer_livechat_id")
  customerFacebookId           String?   @map("customer_facebook_id")
  customerPlaystoreId          String?   @map("customer_playstore_id")
  customerMsisdn               String?   @map("customer_msisdn")
  customerIndihomeNumber       String?   @map("customer_indihome_number")

  @@map("raw_omnix")
}

enum UserRole {
  USER
  ADMIN
}